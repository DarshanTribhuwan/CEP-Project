# SAMPADA AI backend secrets template.
# Copy this file to `.env` and fill in real values. `.env` is git-ignored —
# never commit real keys.

# Encryption at rest (REQUIRED for any deployment with real farmer data).
# Generate once with:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# 32 bytes, base64. Without it, mobile numbers and farm locations are stored
# in clear text and /api/v1/health reports encryption_at_rest: "disabled".
# Rotation: set SAMPADA_ENC_KEYS="new_key,old_key" for one restart, then
# replace with just SAMPADA_ENC_KEY=new_key.
SAMPADA_ENC_KEY=<paste-your-generated-base64-key-here>

# Market prices feed (data.gov.in). Optional — the market endpoint reports
# 503 data_unavailable honestly when the key is missing or the feed is empty.
SAMPADA_DATA_GOV_IN_KEY=<paste-your-data-gov-in-api-key-here>
