# SAMPADA AI — Environment Configuration Template
# Copy this file to .env and fill in your values: cp .env.example .env

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Groq Cloud API Key (Get free key from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Database & Security
SAMPADA_ENC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SAMPADA_DATA_MODE=live
